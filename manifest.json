{
  "name": "Kiwi Text to Speech",
  "description": "Đọc thành tiếng đoạn văn bản bạn chọn trên trang web",
  "version": "0.1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kiwi Text to Speech",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tts",
    "storage",
    "offscreen",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "commands": {
    "doc-doan-da-chon": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Đọc đoạn đang chọn"
    },
    "dung-doc": {
      "suggested_key": { "default": "Alt+X" },
      "description": "Dừng đọc"
    }
  }
}
