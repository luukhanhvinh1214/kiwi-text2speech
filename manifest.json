{
  "name": "Kiwi Text to Speech",
  "description": "Chuyển nội dung văn bản thành âm thanh",
  "version": "0.7.4",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kiwi Text to Speech",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tts",
    "storage",
    "offscreen",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://translate.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup/expand.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "speak-selection": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Đọc đoạn đang chọn"
    },
    "stop-speaking": {
      "suggested_key": { "default": "Alt+X" },
      "description": "Dừng đọc"
    }
  }
}
